# Supabase (Obrigatório para funcionamento geral)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Management API (Opcional — usado para scripts de DDL/administração)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-access-token

# APIs de Inteligência Artificial (Pelo menos uma obrigatória para motor de IA)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# APIs Governamentais (Opcionais)
TRANSPARENCIA_API_KEY=
DATAJUD_API_KEY=

# Analytics e Monitoramento (Opcional)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
