# Supabase (Obrigatório para funcionamento geral)
# O app só lê o banco pelo servidor, com a chave de serviço (NUNCA use prefixo NEXT_PUBLIC_ nela).
# As tabelas não têm leitura pública: a chave anon não é usada.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fallback de URL usado apenas por alguns ETLs CMRJ em scripts/etl/
SUPABASE_URL=

# Supabase - Banco Secundário de Perfis (Opcional - caso utilize separação de storage)
# Se não preenchido, o app local usa o banco principal acima (na Vercel é obrigatório).
# Os ETLs de perfil só gravam no principal com PERFIL_NO_BANCO_PRINCIPAL=1.
# NEXT_PUBLIC_SUPABASE_PERFIL_URL=
# SUPABASE_PERFIL_SERVICE_ROLE_KEY=
# PERFIL_NO_BANCO_PRINCIPAL=1

# Supabase Management API (Opcional — usado para scripts de DDL/administração)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-access-token

# APIs de Inteligência Artificial (Recomendado — sem nenhuma, o sistema usa Heurística L4)
# Só planos GRATUITOS, uma conta por provedor (várias contas no mesmo provedor violam os termos).
# O gateway (src/services/ai/gateway) faz rodízio entre os provedores com chave; os sem chave
# ficam de fora. Confira modelos com `npm run ia:verificar-modelos`.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Opcionais (conferir termos e cota gratuita antes de cadastrar):
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Em desenvolvimento a IA é pulada por padrão (economia de quota).
# Defina como "true" para exercitar a cadeia L1/L2/L3 rodando `npm run dev`.
POLIGRAFO_AI_IN_DEV=

# APIs Governamentais (Opcionais — necessárias apenas para ETLs específicos)
TRANSPARENCIA_API_KEY=
# [Opcional] Para o Datajud do CNJ (aceita com ou sem o prefixo 'APIKey ')
DATAJUD_API_KEY=

# Overrides de URL Governamentais (Opcionais - os scripts já possuem URLs hardcoded oficiais)
# SPU_CSV_URL=https://repositorio.dados.gov.br/seges/raio-x/patrimonio-uniao.csv
# IBAMA_CSV_URL=https://stibamadadosabertosprd.blob.core.windows.net/dados-abertos/dados/SIFISC/auto_infracao/auto_infracao/auto_infracao_csv.zip

# OpenSky Network (Opcional — aumenta o limite de consultas de aeronaves RAB)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# URL pública do site (Opcional — usada para metadata/OG; padrão: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Analytics e Monitoramento (Opcional — desligado por padrão)
# Forks e deploys próprios devem usar os SEUS IDs, nunca os do autor.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
